{
  "name": "@nanmi/harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 pi-agent-core 内核库化的个人 harness（M0-M4：内核 + 机制 + Web GUI）",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "npm run build && node dist/smoke.js",
    "web": "npm run build && node dist/web-server.js",
    "start": "node dist/web-server.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "marked": "^18.0.14",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
